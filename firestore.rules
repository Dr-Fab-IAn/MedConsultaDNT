rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /test/{docId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /establishments/{codigoRenaes} {
      allow read, write: if true;

      match /patients/{patientId} {
        allow read, write: if true;
      }
    }
  }
}
